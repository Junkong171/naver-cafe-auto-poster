{
  "permissions": {
    "allow": [
      "Bash(py -m py_compile cafe_poster.py)",
      "Bash(python -m py_compile cafe_poster.py)",
      "Bash(py cafe_poster.py)",
      "Bash(py cafe_poster.py preview)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git branch)",
      "PowerShell(py -m py_compile cafe_poster.py)",
      "PowerShell(python -m py_compile cafe_poster.py)",
      "PowerShell(py cafe_poster.py)",
      "PowerShell(py cafe_poster.py preview)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log)",
      "PowerShell(git log *)",
      "PowerShell(git branch)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.js\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.js\""
          }
        ]
      }
    ]
  }
}
